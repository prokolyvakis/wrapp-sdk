{
  "name": "@aidvo/wrapp-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Unofficial, server-side TypeScript client for the Wrapp invoicing API.",
  "keywords": [
    "wrapp",
    "invoicing",
    "e-invoicing",
    "typescript",
    "sdk",
    "api-client"
  ],
  "license": "Apache-2.0",
  "author": "Prodromos Kolyvakis",
  "repository": "github:prokolyvakis/wrapp-sdk",
  "homepage": "https://github.com/prokolyvakis/wrapp-sdk#readme",
  "bugs": "https://github.com/prokolyvakis/wrapp-sdk/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "husky",
    "secrets:install": "node scripts/secrets.mjs install",
    "secrets:staged": "node scripts/secrets.mjs staged",
    "secrets:check": "node scripts/secrets.mjs check",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:consumers": "npm run build && node scripts/check-consumers.mjs",
    "check:api": "npm run build && api-extractor run -c api-extractor.json",
    "api:update": "npm run build && api-extractor run --local -c api-extractor.json",
    "test:coverage": "vitest run --coverage",
    "commitlint": "commitlint",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "check:package": "npm run check:api && publint --strict && attw --pack --profile esm-only",
    "prepublishOnly": "node -e \"console.error('Publishing is disabled: complete the release gates and obtain explicit approval.'); process.exit(1)\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.59.1",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "prettier": "3.9.8",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "typescript-5-8": "npm:typescript@5.8.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "lossless-json": "4.3.1",
    "zod": "4.6.5"
  }
}
